# Board 00000000 — worked example, not a real board. Copy it, do not edit it.
#
# The registry is keyed by the Pi's /proc/cpuinfo Serial (last 8 hex digits),
# because the Witty Pi 4 has no readable serial of its own: a Pi and its HAT
# are a bonded pair. See README in this directory for how to register one.
#
# Every value below is a placeholder with the right shape and the wrong
# content. Copying them onto a real board gives you a miscalibrated clock and
# wrong power readings, both of which look like working values.

# ── The crystal trim. Register 37 / 56. ────────────────────────────────────
# A firmware flash destroys this value for good. Read it off the live HAT
# before you ever reflash the controller, and record it here — there is no
# way to recover it afterwards except by re-measuring against a reference
# clock over hours. This is the reason this directory exists.
WITTYPI_RTC_OFFSET=0

# ── ADC trims, measured with a meter on the board ──────────────────────────
# Signed integers. 0 means "not yet measured", which is a legitimate state:
# the board works uncalibrated, it just reports voltages and current less
# accurately.
WITTYPI_ADJ_VIN=0
WITTYPI_ADJ_VOUT=0
WITTYPI_ADJ_IOUT=0
