# /data/wittypi.env — site configuration for the Witty Pi 4 controller
#
# Install as /data/wittypi.env (or wherever your image mounts persistent
# storage). Values here are properties of THIS INSTALLATION and THIS BOARD,
# which is why they belong on persistent storage rather than baked into the
# image: a per-board calibration shared across every board that image is
# written to is wrong on all but one of them.
#
# Read by wittypi-configure.service, which runs `wittypi configure` on every
# boot. That's what makes configuration self-healing — a register corrupted
# in EEPROM is overwritten with the value below at the next boot.
#
# ── Only wittypi-configure.service reads this file ─────────────────────────
# EnvironmentFile= is a systemd directive; an interactive shell does not
# source it. So `wittypi configure` typed at a prompt applies the compiled
# defaults and silently ignores everything below unless you export the same
# variables yourself first.
#
# Apply changes with:   systemctl restart wittypi-configure.service
# Check them with:      systemctl restart wittypi-configure.service && wittypi check
#
# `wittypi check` run bare (with no environment) compares the board against
# the compiled defaults, not against this file — so it can report "out of
# sync" against a board that is correctly configured per this file. Always
# check through the same path you configure through.
#
# Any other unit you add that needs one of these values (a supervisor, a
# notifier) needs its own EnvironmentFile= line — this file is not global
# config, it's specifically what wittypi-configure.service reads.
#
# Values here are not sanity-checked in isolation. `wittypi configure`
# refuses contradictory combinations and exits 2, so a bad edit shows up as
# a failed unit at the next boot, not as a board that quietly misbehaves.
# Run `wittypi check` after editing.

# ── Topology — the one that matters ────────────────────────────────────────
# usb5v | vin2s | vin3s. Decides registers 19, 22 and 41 and nothing else.
# Refused rather than defaulted when unrecognised, because a typo that
# silently left a battery unprotected would look exactly like a working
# board.
#
# Example below assumes 5 V through the USB-C connector (register 7 reads 0).
# Do not set WITTYPI_LOW_VOLTAGE or WITTYPI_RECOVERY_VOLTAGE with usb5v —
# configure refuses the combination. The low-voltage path is inert on a
# fixed 5 V supply, and leaving the thresholds at 255 (disabled) is
# deliberate.
WITTYPI_TOPOLOGY=usb5v

# ── Power sequencing ───────────────────────────────────────────────────────
# Seconds from the shutdown request to the rail being cut (register 21).
# Must comfortably exceed your actual shutdown sequence's duration, including
# any health-check grace period a shutdown gate waits on. The register stores
# x10 in one byte, so 25 (25.0 s) is the ceiling.
WITTYPI_POWER_CUT_DELAY=25

# Seconds between input power returning and the rail coming up (register 47).
# Never above 32 — delay(reg * 1000) overflows a 16-bit int above that, and a
# value like 254 becomes ~49.7 days of rail-off, indistinguishable from dead
# hardware (see WITTYPI.md). Keep it short for a second reason: an alarm2
# elapsing inside this window is consumed without a shutdown, and the board
# then wakes with no scheduled sleep.
WITTYPI_DEFAULT_ON_DELAY=10

# Hours from the last power-on to a forced wake (register 49) — the last line
# of defence if a scheduled alarm is ever missed. Must exceed your duty
# cycle, or it fires at the same instant as the wake it exists to back up and
# you never learn the schedule broke.
WITTYPI_GUARANTEED_WAKE=26

# ── Display annotation (cosmetic, affects nothing on the bus) ──────────────
# Every timestamp this tooling prints is UTC, because everything it reads is
# UTC: the alarm registers, the firmware's own match, the RTC. That is not a
# preference — timing-windows shows a DST conversion is a 3600s discontinuity
# against a far smaller tolerance, so a local-time schedule would be a lost
# wake twice a year.
#
# But a human reading `03:00:00 UTC` at 3am still does the offset in their
# head. State yours once and every timestamp carries it:
#
#     day 12 at 03:00:00 UTC (ET:-4/-5)
#
# It is a CONSTANT STRING, never a conversion: no tzdata needed, no question
# of which of EDT/EST is in force today, nothing to be wrong. Keep it short —
# it is appended to lines that already run near 80 columns on a serial
# console. Unset (the default) prints nothing at all.
#
# Unquoted is safest; a quoted value is accepted and the quotes stripped.
#WITTYPI_TZ_NOTE=ET:-4/-5

# ── Temperature (registers 46 and 44) ──────────────────────────────────────
# The firmware compares the pair, so below must be under over.
WITTYPI_OVER_TEMP=70
WITTYPI_BELOW_TEMP=-20

# ── Per-board calibration — the values a firmware flash destroys ───────────
# Everything above is a policy decision, identical across every board running
# this config. Everything below is a measured property of THIS board's
# components — read your own board's values (WITTYPI.md and
# firmware/wittypi/README.md explain how) rather than copying these.
#
# Register 37 is the PCF85063's calibration offset. initializeRegisters()
# never seeds it, so a wiped EEPROM leaves it at 0 — and flashing wipes
# EEPROM (UUGear say so outright). Nothing else in this system can
# regenerate this value; it must be measured before a flash.
#
# At 0 the clock drifts on the order of a few seconds a day against a
# 2-second alarm match window — on any duty cycle longer than a day, that is
# the difference between waking and not.
WITTYPI_RTC_OFFSET=119

# ADC trims, signed hundredths (registers 24, 25, 26). Shown here at their
# firmware-seed values (24 and 25 default non-zero, 26 defaults to 0) purely
# to illustrate realistic magnitude — measure your own board's actual
# readings against a meter and compute:
#   new_trim = old_trim + (actual - reported) * 100
WITTYPI_ADJ_VIN=20
WITTYPI_ADJ_VOUT=20
WITTYPI_ADJ_IOUT=0
