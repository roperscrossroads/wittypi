#!/bin/sh
# Every timing window in the node, read from ITS OWN SOURCE, in one table —
# then the relationships between them, then the hazards.
#
# ── WHY THIS EXISTS ────────────────────────────────────────────────────────
# The node's behaviour is decided by ~20 numbers that live in eight files, in
# five units (seconds, deci-seconds, hours, 1 Hz tick counts, and a bare count
# of attempts), owned by four components — a Yocto distro, a set of systemd
# drop-ins, a POSIX shell policy script, and AVR firmware this repo does not
# build. Nothing renders them together, so every question of the form "does X
# still fit inside Y" has been answered by reading four files and doing
# arithmetic in your head.
#
# That has now failed five times in two days. Every one of them was a value
# that was individually correct and wrong in company:
#
#   WITTYPI_MARKGOOD_GRACE=120 inside a 15 s power-cut budget
#   GUARANTEED_WAKE=24 h against a 24 h duty cycle
#   GRACE=8 consumed by a `sleep 5` loop, which waits 10
#   DEFAULT_ON_DELAY=254 into `delay(reg * 1000)` on a 16-bit int
#   thermal inhibit 120 s against a mark-good at 312 s
#
# The test suite PINS the relationships that must hold — that is a gate, and it
# belongs in CI. This is the other half: the thing you read when you are about
# to CHANGE one of these numbers and need to see what else moves. A gate says
# pass or fail; this says what the system is.
#
# ── IT RUNS IN TWO PLACES, AND THAT IS THE POINT ───────────────────────────
# In the repo it reads the shipped sources — the COMPILED defaults, i.e. what
# an unconfigured node gets.
#
# On the node it reads the INSTALLED copies of the same files, plus the two
# things no build can see:
#
#   * /data/wittypi.env — the site override. The deployed node runs a 20 s
#     power-cut budget that exists nowhere in this repo.
#   * the controller's own registers — what is actually in the ATtiny's EEPROM,
#     which is the only authority on what the hardware will do. A policy that
#     was never applied and a policy that was applied look identical from the
#     source tree.
#
# So the two modes can disagree, and when they do the board is right.
# Run it in the repo to reason about a change; run it on the node to find out
# what you are actually running.
#
# ── WHAT IT CANNOT COMPUTE, AND HOW THAT STAYS HONEST ──────────────────────
# Two classes of value are not derivable from anything in this tree: how long
# the hardware actually takes (measured with a stopwatch), and the controller's
# firmware constants (compiled into an AVR binary that is neither in this repo
# nor on the node). Both live in `timing-terms`, beside this file, which SHIPS
# INTO THE IMAGE VERBATIM — so the node reads the same bytes rather than a copy.
#
# Nothing is pinned in this script. Where the firmware SOURCE happens to be
# reachable it is cross-checked against timing-terms and a disagreement is a
# hazard, which is the check that matters the day the controller is recompiled.
# On the board the revision register is read and compared as well, because a
# stock controller and a modified one are indistinguishable over I2C unless
# somebody bumped I2C_FW_REVISION.
#
# usage:  timing-windows [--no-live] [--cycle SECONDS] [--on SECONDS]
#         --no-live      skip controller register reads (board mode)
#         --cycle N      duty-cycle period for the guaranteed-wake check
#                        (default 86400 — one wake per day)
#         --on N         awake-window length for the mark-good check
#                        (default: derived from alarm2 on the board; the check
#                        is SKIPPED, not guessed, when no schedule is set)
#
# exit 0 = every invariant holds · exit 1 = at least one does not
set -eu

LIVE=1
CYCLE_SEC=${WITTYPI_CYCLE_SEC:-86400}
ON_SEC=${WITTYPI_ON_SEC:-}
while [ $# -gt 0 ]; do
    case "$1" in
        --no-live) LIVE=0 ;;
        --cycle)   CYCLE_SEC=$2; shift ;;
        --on)      ON_SEC=$2; shift ;;
        -h|--help) sed -n '/^# usage:/,/^# exit/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done

# ── Locating the sources ───────────────────────────────────────────────────
# Deliberately by FILE existence, not by a --mode flag: the wrong mode would
# read nothing and report a table full of blanks, which looks like a system
# with no timing constants rather than a script pointed at the wrong tree.
#
# The repo root is found by ascending, not by counting `..`, so that moving
# this file does not break it. The marker is the driver library, which sits at
# the repo root beside this script.
SELF=$(unset CDPATH; cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || SELF=
REPO=
_d=$SELF
while [ -n "$_d" ] && [ "$_d" != / ]; do
    if [ -r "$_d/wittypi-lib.sh" ]; then REPO=$_d; break; fi
    _d=$(dirname "$_d")
done

# Terms this repo does not own. wake-guard, notify-state and the boot-health
# and storage machinery belong to the integrator's site layer; the watchdog,
# NTP, A/B and bootloader settings belong to their image. This script reports
# on them because the BUDGET spans all of it — a shutdown budget is only
# meaningful as a sum — but it cannot find them on its own. Point it at them
# and the corresponding rows fill in; leave them unset and those rows read `?`,
# which is the honest answer rather than a blank that looks like zero.
SITE_DIR=${WITTYPI_TIMING_SITE_DIR:-}
WATCHDOG=${WITTYPI_TIMING_WATCHDOG:-}
NTPCONF=${WITTYPI_TIMING_NTPCONF:-}
RAUCCONF=${WITTYPI_TIMING_ABCONF:-}
BOOTCMD=${WITTYPI_TIMING_BOOTCMD:-}

if [ -n "$REPO" ]; then
    MODE=repo
    # Flat repo layout: every shipped script at the root, units in systemd/.
    WP_DIR=$REPO
    # This repo's own units are always in systemd/. UNIT_DIR may be pointed
    # elsewhere to pick up the integrator's units, so the two are tracked
    # separately and unit_file searches both — otherwise supplying an
    # integration tree would silently lose this repo's own terms.
    OPS_DIR=$REPO/systemd
    UNIT_DIR=${WITTYPI_TIMING_UNIT_DIR:-$OPS_DIR}
    SITE_DIR=${SITE_DIR:-$REPO}
    TERMS=$SELF/timing-terms
    WHERE="repo $REPO"
    LIVE=0
elif [ -r /usr/bin/wittypi ] || [ -r /usr/libexec/site/wittypi-lib.sh ]; then
    MODE=board
    WP_DIR=/usr/libexec/site
    SITE_DIR=${SITE_DIR:-/usr/libexec/site}
    WATCHDOG=${WATCHDOG:-/etc/systemd/system.conf.d/10-watchdog.conf}
    NTPCONF=${NTPCONF:-/etc/systemd/timesyncd.conf.d/10-ntp-servers.conf}
    RAUCCONF=${RAUCCONF:-/usr/lib/rauc/system.conf}
    # Shipped as file CONTENT, not metadata: mkfs restamps inodes, so anything
    # that must survive into the image has to be content.
    TERMS=/usr/lib/site/timing-terms
    # systemd's unit dir is /usr/lib on a usrmerge image and /lib without, so
    # ask rather than assume.
    for d in /usr/lib/systemd/system /lib/systemd/system; do
        [ -d "$d" ] && { UNIT_DIR=$d; break; }
    done
    UNIT_DIR=${UNIT_DIR:-/usr/lib/systemd/system}
    OPS_DIR=$UNIT_DIR
    WHERE="board $(cat /etc/hostname 2>/dev/null || echo '?')"
else
    echo "not in the repo and not on a node: found neither" >&2
    echo "  <repo>/wittypi-lib.sh  (ascending from $SELF)" >&2
    echo "  /usr/bin/wittypi" >&2
    exit 2
fi

# The policy script: /usr/bin/wittypi on the node, the source file in the repo.
WP_POLICY=$WP_DIR/wittypi
[ -r "$WP_POLICY" ] || WP_POLICY=/usr/bin/wittypi

# ── Extraction ─────────────────────────────────────────────────────────────
# One helper, one shape: pull the first capture of a BRE out of a file, or
# print nothing. Callers decide whether "nothing" is fatal — mostly it is not,
# because a value that has moved to another file should show as `?` rather than
# take the whole report down.
lit() {
    [ -r "$1" ] || return 0
    sed -n "s/$2/\1/p" "$1" 2>/dev/null | head -n 1
}

# Registers 44/52 hold a SIGNED byte: 236 is -20 C, not 236 C. Every place a
# reading from one of them is DISPLAYED goes through this, including the
# failure messages — a hazard line that reports 236 where it means -20 C is
# the one moment the conversion matters most.
wp_signed_or() { [ "$1" -gt 127 ] && echo $(( $1 - 256 )) || echo "$1"; }

# Units are not all in one place in the repo. On the board every unit sits in
# UNIT_DIR; in the tree they are split by owner, and wittypi.service lives with
# the Witty Pi sources rather than with the site layer's. Reading the wrong
# directory returns nothing, and an empty value here reads as "0" and raises a
# hazard about a daemon restart that fits perfectly well.
# Drop-ins are not in the unit directory. On the board a drop-in lives in
# <unit>.d/ beside the unit it modifies, not in the unit directory itself — so
# a flat lookup finds 10-wait-online-bounded.conf and 10-bt-attach-retry.conf
# in the repo (where they sit together) and NOT on the node. The search
# descends one level for exactly that reason.
unit_file() {
    for _u in "$UNIT_DIR/$1" "$OPS_DIR/$1" "$WP_DIR/$1" "$SITE_DIR/$1"; do
        [ -r "$_u" ] && { printf '%s' "$_u"; return 0; }
    done
    _u=$(find "$UNIT_DIR" -mindepth 2 -maxdepth 2 -name "$1" 2>/dev/null | head -n 1)
    [ -n "$_u" ] && { printf '%s' "$_u"; return 0; }
    printf '%s' "$UNIT_DIR/$1"
}

# systemd accepts "2min", "30s", "90" and more. Only the forms actually shipped
# here are handled, and anything else comes back empty rather than being
# guessed at — a silently mis-parsed watchdog is worse than a blank.
secs_of() {
    case "$1" in
        '')             printf '' ;;
        *min)           printf '%s' $(( ${1%min} * 60 )) ;;
        *m)             printf '%s' $(( ${1%m} * 60 )) ;;
        *s)             printf '%s' "${1%s}" ;;
        *[!0-9]*)       printf '' ;;
        *)              printf '%s' "$1" ;;
    esac
}

# ── The terms this repo cannot compute ─────────────────────────────────────
# Measured times and firmware constants come from timing-terms, which is the
# ONE home for both and ships into the image verbatim. Nothing is pinned in
# this file: a second copy that is never compared is how two numbers become
# three, and a comment promising they will be compared is not a mechanism.
#
# This is also why the report prints checksums. Host and target read the
# same bytes or they do not, and "probably in sync" is not a state anyone can
# act on. Run it in both places and compare the two numbers.
term() {
    _t=$(lit "$TERMS" "^$1=\([0-9][0-9]*\)$")
    if [ -z "$_t" ]; then
        printf 'timing-terms is missing %s (looked in %s)\n' "$1" "$TERMS" >&2
        exit 3
    fi
    printf '%s' "$_t"
}

[ -r "$TERMS" ] || { printf 'no timing-terms at %s\n' "$TERMS" >&2; exit 3; }

T_BOOT=$(term T_BOOT)
T_MARKGOOD=$(term T_MARKGOOD)
T_SHUTDOWN=$(term T_SHUTDOWN)

FW_REV_TERM=$(term FW_REV)
ALARM_WIN=$(term FW_ALARM_WINDOW)
THERM_INHIBIT=$(term FW_THERMAL_INHIBIT)
ALARM1_RETRY=$(term FW_ALARM1_RETRY)
PULSE=$(term FW_PULSE_INTERVAL)

# ── The firmware source, when it is reachable, as a CROSS-CHECK ────────────
# timing-terms is the home; the firmware source is the authority. They agree
# or someone changed one without the other — which is precisely what happens
# when the controller is recompiled with different settings, and precisely the
# case where every downstream guard quietly starts reasoning about hardware
# that no longer exists.
FW_SRC=${WITTYPI_FW_SRC:-}
FW_DRIFT=
if [ -r "$FW_SRC" ]; then
    FW_HOW='timing-terms, cross-checked against the firmware source'
    FW_WHERE=$(basename "$FW_SRC")
    _ck() {  # _ck <label> <term-value> <bre>
        _v=$(lit "$FW_SRC" "$3")
        [ -n "$_v" ] || { FW_DRIFT="$FW_DRIFT $1(not found in source)"; return 0; }
        [ "$_v" = "$2" ] || FW_DRIFT="$FW_DRIFT $1(terms $2, source $_v)"
    }
    _ck FW_REV            "$FW_REV_TERM"   '.*I2C_FW_REVISION\] = 0x0*\([0-9]*\);.*'
    _ck FW_ALARM_WINDOW   "$ALARM_WIN"     '.*overdue_alarm1 >= 0 && overdue_alarm1 < \([0-9]*\).*'
    _ck FW_THERMAL_INHIBIT "$THERM_INHIBIT" '.*skipTempShutdownCount < \([0-9]*\).*'
    _ck FW_ALARM1_RETRY   "$ALARM1_RETRY"  '.*alarm1Delayed == \([0-9]*\).*'
    _ck FW_PULSE_INTERVAL "$PULSE"         '.*I2C_CONF_PULSE_INTERVAL\] = \([0-9]*\);.*'
else
    FW_HOW='timing-terms'
    FW_WHERE="rev $FW_REV_TERM, no firmware source here to cross-check"
fi

# ── Compiled policy defaults ───────────────────────────────────────────────
# One level of indirection is expected. The policy's fallbacks were hoisted
# out of the inline ${VAR:-N} form into WP_FALLBACK_N assignments so the tool's
# own help text could interpolate them rather than repeat them. Without this,
# every value below would read back as the literal "$WP_FALLBACK_..." and the
# report would print it as though it were a number.
deref() {
    case "$2" in
        \$*) lit "$1" "^${2#\$}=\\(-\\{0,1\\}[0-9][0-9]*\\).*" ;;
        *)   printf '%s' "$2" ;;
    esac
}
PCD_DEF=$(deref "$WP_POLICY" "$(lit "$WP_POLICY"   '.*WITTYPI_POWER_CUT_DELAY:-\([^}]*\)}.*')")
DON_DEF=$(deref "$WP_POLICY" "$(lit "$WP_POLICY"   '.*WITTYPI_DEFAULT_ON_DELAY:-\([^}]*\)}.*')")
GW_DEF=$(deref "$WP_POLICY" "$(lit "$WP_POLICY"    '.*WITTYPI_GUARANTEED_WAKE:-\([^}]*\)}.*')")
OVERT_DEF=$(deref "$WP_POLICY" "$(lit "$WP_POLICY" '.*WITTYPI_OVER_TEMP:-\([^}]*\)}.*')")

DON_MAX=$(lit "$WP_DIR/wittypi-lib.sh" '^WP_MAX_DEFAULT_ON_DELAY=\([0-9]*\).*')
PCD_MIN=$(lit "$WP_DIR/wittypi-lib.sh" '^WP_MIN_POWER_CUT_DELAY=\([0-9]*\).*')
PCD_MAX=$(lit "$WP_DIR/wittypi-lib.sh" '^WP_MAX_POWER_CUT_DELAY=\([0-9]*\).*')

GRACE=$(lit "$WP_DIR/wittypi-before-shutdown" '.*WITTYPI_MARKGOOD_GRACE:-\([0-9]*\).*')
POLL=$(lit  "$WP_DIR/wittypi-before-shutdown" '^ *sleep \([0-9][0-9]*\)$')
SETTLE=$(lit "$WP_DIR/wittypi-daemon" '.*WITTYPI_HALT_SETTLE_SEC:-\([0-9]*\).*')

# The shutdown notification is a third term in the power-cut budget.
# wittypi-daemon calls notify-state BEFORE the gate, while the network is still
# up, and that call is on the same 20 s clock the rail is counting. Deriving it
# here rather than hardcoding it is what keeps the relationship below checking
# the arithmetic the node actually runs.
#
# Zero when the daemon does not call it, so a site that removes the call gets
# its two-term budget back rather than a phantom reservation.
# The shutdown sequence has four terms, not two. In order, from the
# moment GPIO-4 falls and POWER_CUT_DELAY starts counting:
#
#   1. wake-guard ensure   (daemon)  arm a fallback wake if none is scheduled
#   2. notify-state shutdown         say why, and when we intend to be back
#   3. the mark-good gate            bounded wait for the health verdict
#   4. Linux shutting down           + a SECOND wake-guard run via ExecStop
#
# Deriving terms 1 and 2 here rather than hardcoding them means removing either
# call from the daemon gives the budget back automatically instead of leaving a
# phantom reservation behind.
if grep -q 'WP_WAKE_GUARD.*ensure' "$WP_DIR/wittypi-daemon" 2>/dev/null; then
    # Bounded by the unit that also runs it on the Linux-initiated path; that
    # TimeoutStopSec is the only hard cap either invocation has.
    #
    # This must read $UNIT_DIR, not $SITE_DIR — on the node they differ.
    # $SITE_DIR is /usr/libexec/site, where only the wake-guard SCRIPT lives;
    # the .service is in the systemd unit dir. Reading the wrong one makes the
    # term silently 0, and the node renders its own budget as
    # "0 + 2 + 8 + 8 = 18 < 25, ok" — five seconds under-counted, with an ok
    # verdict. In repo mode the two dirs are the same, so an offline check
    # passes either way. The familiar shape: confident output that could not
    # fail.
    WAKE_GUARD_SD=$(lit "$(unit_file wake-guard.service)" '^TimeoutStopSec=\([0-9]*\).*')
    WAKE_GUARD_SD=${WAKE_GUARD_SD:-0}
else
    WAKE_GUARD_SD=0
fi

NOTIFY_STATE="$SITE_DIR/notify-state"
if grep -q 'WP_NOTIFY_STATE.*shutdown' "$WP_DIR/wittypi-daemon" 2>/dev/null; then
    NOTIFY_SD=$(lit "$NOTIFY_STATE" '.*NOTIFY_STATE_SHUTDOWN_TIMEOUT:-\([0-9]*\).*')
    NOTIFY_SD=${NOTIFY_SD:-0}
else
    NOTIFY_SD=0
fi

# The supervisor's stop, in the coincidence case: a shutdown racing a
# wittypi-watch tick stops the watch FIRST (its unit's After=wake-guard
# inverts to stop-before), THEN runs wake-guard's ExecStop — serialised, so
# the watch's TimeoutStopSec is a real addend, not overlap. Derived from the
# unit like the terms above: no supervisor installed, no reservation.
_watch_unit=$(unit_file wittypi-watch.service)
if [ -r "$_watch_unit" ]; then
    WATCH_SD=$(lit "$_watch_unit" '^TimeoutStopSec=\([0-9]*\).*')
    WATCH_SD=${WATCH_SD:-0}
else
    WATCH_SD=0
fi

# Effective, not configured. The whole reason this file computes rather than
# reports: a deadline of 8 inside a loop that sleeps 5 unconditionally is a
# deadline of 10. The clamp (`sleep "$wp_left"` on the last iteration) is what
# makes 8 mean 8, so its PRESENCE is what decides which arithmetic applies.
if grep -q 'sleep "[$]wp_left"' "$WP_DIR/wittypi-before-shutdown" 2>/dev/null; then
    GRACE_EFF=$GRACE
    GRACE_NOTE="clamped"
else
    GRACE_EFF=$(( ( (GRACE + POLL - 1) / POLL ) * POLL ))
    GRACE_NOTE="rounded up to a multiple of ${POLL}s by the poll loop"
fi

SOAK=$(lit "$SITE_DIR/boot-health-check" '.*HEALTH_SOAK_SEC:-\([0-9]*\).*')
GUARD_INT=$(lit "$SITE_DIR/storage-guard" '.*GUARD_INTERVAL:-\([0-9]*\).*')
SLOT_FAIL=$(lit "$SITE_DIR/boot-slot-health" '.*SLOT_FAIL_THRESHOLD:-\([0-9]*\).*')

# Resolved once, through the same helper as the other unit reads below, and
# reused by the relationship checks so the value read and the file tested for
# presence can never be two different paths.
STORAGE_GUARD_UNIT=$(unit_file storage-guard.service)
BOOT_GATE_UNIT=$(unit_file boot-health-check.service)
GUARD_WD=$(secs_of "$(lit "$STORAGE_GUARD_UNIT" '^WatchdogSec=\(.*\)$')")
GATE_TMO=$(secs_of "$(lit "$BOOT_GATE_UNIT" '^TimeoutStartSec=\(.*\)$')")
RT_WD=$(secs_of "$(lit "$WATCHDOG" '^RuntimeWatchdogSec=\(.*\)$')")
RB_WD=$(secs_of "$(lit "$WATCHDOG" '^RebootWatchdogSec=\(.*\)$')")
NTP_MIN=$(lit "$NTPCONF" '^PollIntervalMinSec=\([0-9]*\).*')
NTP_MAX=$(lit "$NTPCONF" '^PollIntervalMaxSec=\([0-9]*\).*')
ATTEMPTS=$(lit "$RAUCCONF" '^boot-attempts=\([0-9]*\).*')

# ── Bounded waits ──────────────────────────────────────────────────────────
# These do not couple to the duty cycle the way the power-sequencing constants
# do, which is exactly why they are easy to overlook — but they all bound how
# long a boot can take, and the health gate has to outlast their sum or the
# slot is condemned by patience.
# boot-request is a human-facing command, so it goes to ${bindir} rather than
# libexec — the same placement, and the same reasoning, as wittypi itself.
site_cmd() {
    for _c in "$SITE_DIR/$1" "/usr/bin/$1"; do
        [ -r "$_c" ] && { printf '%s' "$_c"; return 0; }
    done
    printf '%s' "$SITE_DIR/$1"
}
DAEMON_RESTART=$(secs_of "$(lit "$(unit_file wittypi.service)" '^RestartSec=\(.*\)$')")
WIFI_TMO=$(secs_of "$(lit "$(unit_file wifi-autostart.service)" '^TimeoutStartSec=\(.*\)$')")
NTP_SAVE=$(lit "$NTPCONF" '^SaveIntervalSec=\([0-9]*\).*')
WAIT_ONLINE=$(lit "$(unit_file 10-wait-online-bounded.conf)" '^ExecStart=.*--timeout=\([0-9]*\).*')
BT_RETRY=$(lit "$(unit_file 10-bt-attach-retry.conf)" '^ExecStart=.*bt-attach [a-z0-9]* \([0-9]*\) *$')
CONSOLE_DELAY=$(lit "$(site_cmd boot-request)" '.*CONSOLE_DELAY:-\([0-9]*\).*')
PANIC=$(lit "$BOOTCMD" '.*panic=\([0-9]*\).*')

# ── Live values: the site override and the hardware itself ─────────────────
PCD=$PCD_DEF; DON=$DON_DEF; GW=$GW_DEF
PCD_SRC="compiled default"; DON_SRC="compiled default"; GW_SRC="compiled default"
FW_REV=; DEFAULT_ON=; PWR_MODE=; OVERT_ACT=
# Declared here, not only inside the live block. `set -u` makes an unset
# reference fatal, and repo mode never enters that block — without these
# declarations the LM75B check kills the report outright whenever it runs
# offline, while board mode passes, which is exactly how a half-tested
# addition looks.
MCU_OVERT=; MCU_BELOWT=; LM_TOS=; LM_THYST=

ENVFILE=/data/wittypi.env
if [ "$MODE" = board ] && [ -r "$ENVFILE" ]; then
    # Sourced in a subshell and read back, never into this shell: the file is
    # site-writable and this script must not inherit whatever else is in it.
    for v in POWER_CUT_DELAY DEFAULT_ON_DELAY GUARANTEED_WAKE; do
        val=$(lit "$ENVFILE" "^WITTYPI_$v=\([0-9]*\).*")
        [ -n "$val" ] || continue
        case "$v" in
            POWER_CUT_DELAY)  PCD=$val; PCD_SRC="site $ENVFILE" ;;
            DEFAULT_ON_DELAY) DON=$val; DON_SRC="site $ENVFILE" ;;
            GUARANTEED_WAKE)  GW=$val;  GW_SRC="site $ENVFILE" ;;
        esac
    done
fi

# One register read, defined at top level because the awake-window derivation
# below needs it too and a helper that exists only inside one branch is a trap.
r() { wittypi get "$1" 2>/dev/null | tr -dc '0-9-' ; }

if [ "$LIVE" = 1 ] && command -v wittypi >/dev/null 2>&1; then
    # EEPROM beats both files. A register holds what was last WRITTEN to it;
    # a policy file holds what the next `wittypi configure` would write. Those
    # differ on any node where configure has not run since the file changed,
    # and that gap is exactly where the 254 outage lived.
    v=$(r 21); [ -n "$v" ] && { PCD=$(( v / 10 )); PCD_SRC="register 21 (live)"; }
    v=$(r 47); [ -n "$v" ] && { DON=$v; DON_SRC="register 47 (live)"; }
    v=$(r 49); [ -n "$v" ] && {
        # bit 7 is the unit: 0 = hours, 1 = days.
        if [ "$(( v & 128 ))" -ne 0 ]; then
            GW=$(( (v & 127) * 24 )); GW_SRC="register 49 (live, days)"
        else
            GW=$(( v & 127 )); GW_SRC="register 49 (live, hours)"
        fi
    }
    FW_REV=$(r 12); DEFAULT_ON=$(r 17); PWR_MODE=$(r 7); OVERT_ACT=$(r 45)
    # The MCU's copies of the temperature points, and the LM75B's OWN registers.
    # They are written from the copies, but only at MCU reset — see the check.
    MCU_OVERT=$(r 46); MCU_BELOWT=$(r 44)
    LM_TOS=$(r 53);    LM_THYST=$(r 52)
fi

# ── The awake window ───────────────────────────────────────────────────────
# The awake window is not /proc/uptime, and substituting one for the other asks
# a different question. Uptime is how long the node has been up SO FAR; the
# awake window is how long it will be up in TOTAL. Read 270 s into a boot,
# uptime reports a 270 s window and raises a hazard against a mark-good at
# 312 s on a node with no schedule set at all — a plausible number from a
# plausible file that does not mean what the check needs.
#
# The window is alarm2 minus power-on, and alarm2 lives in registers 32-36 as
# BCD. When it is unset there IS no window, and the honest answer is to say so
# and assert nothing — a check that invents its own input is worse than absent,
# because it produces confident output.
ON_WHY=
if [ -z "$ON_SEC" ] && [ "$LIVE" = 1 ] && command -v wittypi >/dev/null 2>&1; then
    bcd() { printf '%s' $(( ( ${1:-0} / 16 ) * 10 + ( ${1:-0} % 16 ) )); }
    a2s=$(r 32); a2m=$(r 33); a2h=$(r 34); a2d=$(r 35)
    if [ "${a2s:-0}${a2m:-0}${a2h:-0}${a2d:-0}" = "0000" ]; then
        ON_WHY="no alarm2 is set — nothing will shut this node down on a schedule"
    else
        # Same arithmetic the firmware uses: date*86400 + h*3600 + m*60 + s.
        _a2=$(( $(bcd "$a2d") * 86400 + $(bcd "$a2h") * 3600 \
                + $(bcd "$a2m") * 60 + $(bcd "$a2s") ))
        _now=$(date -u '+%_d %_H %_M %_S' 2>/dev/null | \
               awk '{print $1 * 86400 + $2 * 3600 + $3 * 60 + $4}')
        _up=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
        if [ -n "$_now" ] && [ -n "$_up" ] && [ "$_a2" -gt "$_now" ]; then
            ON_SEC=$(( _up + _a2 - _now ))
            ON_WHY="alarm2 in $(( _a2 - _now ))s + ${_up}s already up"
        else
            ON_WHY="alarm2 is set but not ahead of the clock (overdue, or next month)"
        fi
    fi
fi

# ── Rendering ──────────────────────────────────────────────────────────────
if [ -t 1 ]; then B=$(printf '\033[1m'); R=$(printf '\033[31m'); G=$(printf '\033[32m')
                 Y=$(printf '\033[33m'); Z=$(printf '\033[0m')
else B=; R=; G=; Y=; Z=; fi

hdr() { printf '\n%s── %s ──%s\n' "$B" "$1" "$Z"; }
row() { printf '  %-30s %10s   %s\n' "$1" "${2:-?}" "${3:-}"; }

hazards=0; notes=0
ok()   { printf '  %sok%s    %s\n' "$G" "$Z" "$1"; }
haz()  { printf '  %sHAZARD%s %s\n         %s\n' "$R" "$Z" "$1" "$2"; hazards=$((hazards + 1)); }
note() { printf '  %snote%s  %s\n' "$Y" "$Z" "$1"; notes=$((notes + 1)); }

# ── The fingerprint ────────────────────────────────────────────────────────
# This is the one line that answers "are the host and the node in sync?"
# This script and its terms file ship into the image as the SAME BYTES they
# have in the repo — there is no generation step, no template, no second copy.
# So a repo run and a board run print the same two checksums, or they do not,
# and "probably the same version" stops being a thing anyone has to assume.
#
# "busybox has cksum everywhere" is an assumption, not a check, and it does not
# hold here: the node has md5sum and sha256sum and no cksum. A single hardcoded
# tool makes the fingerprint line print EMPTY — empty rather than '?', because
# a `||` fallback only fires if the whole pipeline fails, and `cut` succeeds
# happily on no input. The one line built to answer "are these two in sync?"
# would then silently answer nothing.
#
# So: try tools in order, take the first that produces output, and say WHICH
# one produced it — comparing an md5 against a sha256 would otherwise look like
# a real mismatch. If none work, say so out loud.
fp() {
    for _t in md5sum sha256sum cksum; do
        command -v "$_t" >/dev/null 2>&1 || continue
        _v=$("$_t" "$1" 2>/dev/null | cut -d' ' -f1 | cut -c1-12)
        [ -n "$_v" ] && { printf '%s:%s' "${_t%sum}" "$_v"; return 0; }
    done
    printf 'UNAVAILABLE'
}

printf '%swittypi — every timing window, and what couples them%s\n' "$B" "$Z"
printf 'read from: %s\n' "$WHERE"
printf 'fingerprint: script %s · terms %s   %s\n' \
    "$(fp "$0")" "$(fp "$TERMS")" \
    "$([ "$MODE" = repo ] && printf 'run this on the node; equal numbers = same logic, same terms' \
                          || printf 'compare with the same script run in the repo')"
printf 'firmware constants: %s (%s)\n' "$FW_HOW" "$FW_WHERE"
[ "$LIVE" = 1 ] && printf 'controller registers: live\n' \
                || printf 'controller registers: not read%s\n' \
                   "$([ "$MODE" = repo ] && echo ' (repo mode — there is no hardware here)')"

hdr "CONTROLLER — ATtiny841. Every counter below is a 1 Hz tick"
row "alarm match window" "${ALARM_WIN}s" "coincidence test, NOT a timeout"
row "thermal inhibit after power-on" "${THERM_INHIBIT}s" "over/below-temp action suppressed"
row "alarm1 delayed retry" "${ALARM1_RETRY}s" "when a wake lands while powered"
row "power-cut delay (reg 21)" "${PCD}s" "$PCD_SRC"
row "default-on delay (reg 47)" "${DON}s" "$DON_SRC"
row "guaranteed wake (reg 49)" "${GW}h" "$GW_SRC"
row "sleep pulse (reg 18)" "${PULSE}s" "firmware factory default; policy does not set it"
[ -n "$FW_REV" ]     && row "firmware revision (reg 12)" "$FW_REV" "live"
[ -n "$DEFAULT_ON" ] && row "default-on (reg 17)" "$DEFAULT_ON" "1 = return without the button"
[ -n "$PWR_MODE" ]   && row "power mode (reg 7)" "$PWR_MODE" "0 = USB-C, 1 = VIN"

hdr "LINUX — measured"
