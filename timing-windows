hdr "LINUX — configured"
row "health soak" "${SOAK}s" "to UPTIME ${SOAK}s, not ${SOAK}s after the gate"
row "mark-good grace" "${GRACE}s -> ${GRACE_EFF}s" "$GRACE_NOTE"
row "supervisor stop" "${WATCH_SD}s" "wittypi-watch.service — a shutdown budget term, see the sum"
row "poll interval" "${POLL}s" "wittypi-before-shutdown"
