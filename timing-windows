# ── The relationships ──────────────────────────────────────────────────────
# Some terms below come from the integrator's site layer and image, not from
# this repo (see "Terms this repo does not own" above). An absent term there is
# not a broken extractor, and reporting it as a HAZARD would fill the report
# with alarms about files that were never meant to be here — the same alarm
# fatigue the supervisor is written to avoid. So: if the file that OWNS a term
# is not in this tree, the check says it was not run; if the file IS here and
# the value still could not be read, that is a real extraction failure and
# stays a hazard.
#
#   have_src FILE...  — true when every named file exists and is readable
have_src() {
    for _hs in "$@"; do
        [ -n "$_hs" ] && [ -r "$_hs" ] || return 1
    done
    return 0
}

hdr "RELATIONSHIPS — each one has been violated at least once"

# 1. The shutdown must finish before the rail is cut. This is THE invariant:
#    everything downstream of a cut mid-write is a corrupt /data.
# T_SHUTDOWN includes wake-guard.service's ExecStop, measured from a real
# `systemctl poweroff` console capture. It is close to a WORST case, not a
# typical one: alarm1 was cleared before that capture, so the ExecStop took the
# slow "arm from nothing" path (4.004s of the 8.022s total) rather than the
# fast already-armed recheck (~0.7s) the real controller-initiated path should
# usually hit, because wittypi-daemon's own wake-guard call (WAKE_GUARD_SD,
# budgeted separately below) normally arms it first. A Linux-initiated shutdown
# with nothing pre-armed gets no such reservation and pays the full cost
# captured here — a real path, not a contrived one. See timing-terms for the
# full breakdown.
# WATCH_SD is the supervisor's term: a shutdown racing a wittypi-watch tick
# stops the watch first, serialised ahead of wake-guard's ExecStop by the unit
# ordering, so its TimeoutStopSec is a fifth term.
_SD_TOTAL=$(( WATCH_SD + WAKE_GUARD_SD + NOTIFY_SD + GRACE_EFF + T_SHUTDOWN ))
if [ "$_SD_TOTAL" -lt "$PCD" ]; then
    ok "watch + wake-guard + notify + grace + shutdown < power-cut: ${WATCH_SD} + ${WAKE_GUARD_SD} + ${NOTIFY_SD} + ${GRACE_EFF} + ${T_SHUTDOWN} = ${_SD_TOTAL} < ${PCD}s"
    # Passing is not the same as having room. T_shutdown is ONE measurement of
    #    a clean shutdown; a node with more dirty pages, a unit that is slow to
    #    stop, or a `sync` against a tired card takes longer, and the budget does
    #    not stretch. The slack should be at least another whole shutdown — so
    #    that the measurement being wrong by 100% is survivable rather than a
    #    cut mid-write. At the compiled 15s it is 1s.
    _slack=$(( PCD - _SD_TOTAL ))
    note "T_shutdown (${T_SHUTDOWN}s) is a real capture, but close to a
        worst case (a full wake-guard arm, not its fast recheck) — see timing-terms."
    if [ "$_slack" -lt "$T_SHUTDOWN" ]; then
        # The advice has to key off the headroom that actually remains, not
        # off the configured delay. This note only fires when the slack is
        # LESS than one shutdown, so any wording claiming that two shutdowns
        # fit would contradict the branch it is printed from.
        note "$(printf 'but only %ss of slack, against a shutdown measured ONCE at %ss. A shutdown\n        that runs %ss over budget is cut mid-write. %s' \
            "$_slack" "$T_SHUTDOWN" "$_slack" \
            "$([ "$PCD" -lt "$PCD_MAX" ] \
                && printf 'Raising the power-cut delay to %ss (the ceiling) would buy %ss more\n        for nothing but a longer wait before the rail drops.' "$PCD_MAX" "$(( PCD_MAX - PCD ))" \
                || printf 'The delay is already at its %ss ceiling. The shutdown notify timeout has\n        already been cut 3s -> 2s (untested) to claw back 1s; the rest needs\n        a re-measurement of the fast (already-armed) wake-guard path or a smaller grace.' "$PCD_MAX")")"
    fi
else
    haz "watch + wake-guard + notify + grace + shutdown >= power-cut: ${WATCH_SD} + ${WAKE_GUARD_SD} + ${NOTIFY_SD} + ${GRACE_EFF} + ${T_SHUTDOWN} = ${_SD_TOTAL} >= ${PCD}s" \
        "the rail falls mid-shutdown. /data is mounted rw until the very end of it."
fi

# 2. Register 21 is deci-seconds in ONE BYTE, and 255 is the never-written
#    sentinel — so the representable ceiling is 25 s, not 25.5.
if [ "$PCD" -le "${PCD_MAX:-25}" ] && [ "$PCD" -ge "${PCD_MIN:-15}" ]; then
    ok "power-cut delay in range: ${PCD_MIN:-15} <= ${PCD} <= ${PCD_MAX:-25}s"
else
    haz "power-cut delay ${PCD}s is outside ${PCD_MIN:-15}..${PCD_MAX:-25}" \
        "reg 21 stores x10 in a byte and 255 means 'never written'; below ${PCD_MIN:-15}s there is no shutdown budget."
fi

# 3. The overflow that cost a 23-minute outage: delay(reg * 1000) on a 16-bit
#    int. 33 * 1000 = 33000, already past 32767, and the sign flip becomes
#    ~49.7 DAYS of rail-off — indistinguishable from dead hardware.
if [ "$DON" -le "${DON_MAX:-32}" ]; then
    ok "default-on delay within the firmware's arithmetic: ${DON} <= ${DON_MAX:-32}"
else
    haz "default-on delay ${DON} overflows the firmware" \
        "delay(${DON} * 1000) wraps a 16-bit int; the rail stays down for weeks, looking exactly like a dead board."
fi

# 4. Layer 3 must OUTLAST the scheduled wake it backs up, or it fires first and
#    the backup becomes the mechanism.
if [ "$(( GW * 3600 ))" -gt "$CYCLE_SEC" ]; then
    ok "guaranteed wake outlasts the cycle: ${GW}h > $(( CYCLE_SEC / 3600 ))h"
else
    haz "guaranteed wake ${GW}h does not clear a $(( CYCLE_SEC / 3600 ))h cycle" \
        "layer 3 races the alarm it exists to back up; a healthy node wakes on the wrong mechanism and you never learn the alarm broke."
fi

# 5. A gate that times out before its own soak completes fails the boot it was
#    about to pass.
if ! have_src "$SITE_DIR/boot-health-check" "$BOOT_GATE_UNIT"; then
    note "boot gate vs soak NOT CHECKED: no boot-health gate in this tree.
        Set WITTYPI_TIMING_SITE_DIR/_UNIT_DIR to include one."
elif [ -n "$GATE_TMO" ] && [ -n "$SOAK" ] && [ "$GATE_TMO" -gt "$SOAK" ]; then
    ok "gate timeout exceeds the soak: ${GATE_TMO} > ${SOAK}s"
else
    haz "gate timeout ${GATE_TMO}s does not exceed the soak ${SOAK}s" \
        "the health gate is killed mid-soak, so the boot is never marked good and repeated boots condemn the slot."
fi

# 6. One missed keepalive must not be a reset. Two is a signal; one is jitter.
if ! have_src "$SITE_DIR/storage-guard" "$STORAGE_GUARD_UNIT"; then
    note "storage-guard watchdog NOT CHECKED: no storage-guard in this tree."
elif [ -n "$GUARD_WD" ] && [ -n "$GUARD_INT" ] && [ "$GUARD_WD" -ge "$(( GUARD_INT * 2 ))" ]; then
    ok "storage-guard watchdog >= 2x keepalive: ${GUARD_WD} >= $(( GUARD_INT * 2 ))s"
else
    haz "storage-guard watchdog ${GUARD_WD}s < 2x keepalive $(( ${GUARD_INT:-0} * 2 ))s" \
        "a single late keepalive reboots the node with FailureAction=reboot-immediate."
fi

# 7. The awake window has to be long enough to GET the attempt back. A node
#    that wakes, works, and sleeps before mark-good spends an attempt per
#    cycle and condemns the slot in $ATTEMPTS wakes with nothing wrong.
if [ -z "$ON_SEC" ]; then
    note "awake window NOT CHECKED: ${ON_WHY:-no window supplied}.
        Pass --on SECONDS to test a window this node is not currently running."
elif [ "$ON_SEC" -gt "$(( T_MARKGOOD + 60 ))" ]; then
    ok "awake window clears mark-good: ${ON_SEC}s > ${T_MARKGOOD}s + 60s margin${ON_WHY:+  ($ON_WHY)}"
else
    haz "awake window ${ON_SEC}s does not clear mark-good ${T_MARKGOOD}s + margin${ON_WHY:+  ($ON_WHY)}" \
        "each cycle spends a boot attempt that is never returned; ${ATTEMPTS:-3} wakes condemn the slot with nothing actually wrong."
fi

# 8. The open one. The controller stops suppressing temperature actions long
#    before Linux gets its attempt back, so there is a window on EVERY boot in
#    which a trip costs an attempt permanently.
if [ "$THERM_INHIBIT" -ge "$T_MARKGOOD" ]; then
    ok "thermal inhibit covers mark-good: ${THERM_INHIBIT} >= ${T_MARKGOOD}s"
else
    haz "thermal inhibit (${THERM_INHIBIT}s) expires $(( T_MARKGOOD - THERM_INHIBIT ))s before mark-good (${T_MARKGOOD}s)" \
        "$(printf 'a %ss window on EVERY boot where a temperature trip spends an attempt nothing returns.%s' \
            "$(( T_MARKGOOD - THERM_INHIBIT ))" \
            "$([ "${OVERT_ACT:-1}" = 0 ] && echo ' Currently inert: reg 45 = 0, over-temp action disabled.' || echo " Live: over-temp action is enabled at ${OVERT_DEF}C.")")"
fi

# 8b. The bounded waits must fit inside the gate that is waiting for them.
# An unreadable bound is not a bound of zero. Defaulting a missing value to
# 0 makes the sum smaller and the invariant PASS — the failure mode where a
# broken extractor reads as good news.
if ! have_src "$SITE_DIR/boot-health-check" "$BOOT_GATE_UNIT"; then
    note "bounded waits vs gate NOT CHECKED: no boot-health gate in this tree."
else
_missing=
for _n in WAIT_ONLINE WIFI_TMO BT_RETRY DAEMON_RESTART CONSOLE_DELAY; do
    eval "_bv=\$$_n"
    [ -n "$_bv" ] || _missing="$_missing $_n"
done
_waits=$(( ${WAIT_ONLINE:-0} + ${WIFI_TMO:-0} + ${BT_RETRY:-0} ))
if [ -n "$_missing" ]; then
    haz "bounded waits could not all be read:$_missing" \
        "the sum below is missing them, so it is smaller than the truth and the check is weaker than it looks. Fix the extractor, do not trust the pass."
fi
if [ -n "$GATE_TMO" ] && [ "$GATE_TMO" -gt "$(( _waits + SOAK ))" ]; then
    ok "bounded waits + soak fit the gate: ${_waits} + ${SOAK} = $(( _waits + SOAK )) < ${GATE_TMO}s"
else
    haz "bounded waits + soak ($(( _waits + SOAK ))s) do not fit the gate timeout (${GATE_TMO}s)" \
        "a boot that hits every bound is killed by TimeoutStartSec and the boot is condemned for being SLOW, not broken — the one failure mode a rollback cannot distinguish."
fi
fi

# 8c. The daemon is the only thing watching the halt line. If it dies at the
#     wrong moment, the rail is cut on the controller's schedule regardless.
if [ -n "$DAEMON_RESTART" ] && [ "$(( DAEMON_RESTART + T_SHUTDOWN ))" -lt "$PCD" ]; then
    ok "daemon restart + shutdown fits the power-cut budget: ${DAEMON_RESTART} + ${T_SHUTDOWN} < ${PCD}s"
else
    haz "daemon restart (${DAEMON_RESTART}s) + shutdown (${T_SHUTDOWN}s) does not fit ${PCD}s" \
        "if the daemon dies just as alarm2 fires, it cannot restart, notice the halt line and shut down before the rail is cut."
fi

# 8d. The MCU's temperature points vs the sensor's own. Registers 44 and 46
#     are pushed into the LM75B by initializeRegisters() — at MCU RESET ONLY.
#     `wittypi configure` writes the MCU's copies and nothing carries the change
#     onward, so after any event that re-seeds them (a firmware flash wipes
#     EEPROM) the sensor keeps stale thresholds until the next power cycle.
#     Detected by diffing a register dump; invisible to every other check. The
#     firmware forwards exactly one register on write — 37, to the RTC — which
#     is why the RTC offset never has this problem and these do.
if [ -n "$MCU_OVERT" ] && [ -n "$LM_TOS" ] && [ -n "$MCU_BELOWT" ] && [ -n "$LM_THYST" ]; then
    if [ "$MCU_OVERT" = "$LM_TOS" ] && [ "$MCU_BELOWT" = "$LM_THYST" ]; then
        ok "the LM75B holds the configured thresholds (over $MCU_OVERT, below $(wp_signed_or "$MCU_BELOWT"))"
    else
        haz "the LM75B's own thresholds do not match the policy: TOS=$LM_TOS vs reg46=$MCU_OVERT, THYST=$(wp_signed_or "$LM_THYST") vs reg44=$(wp_signed_or "$MCU_BELOWT")" \
            "configure fixed the MCU's copies; only an MCU RESET pushes them to the sensor. Shutdown still uses the MCU copy in software, so this is bounded — but the sensor's OS/ALARM pin is wrong until the next power cycle."
    fi
fi

# 9. timing-terms against the firmware source, when both are reachable.
#    This is the check that matters when you recompile the controller. The
#    terms file is the home and the firmware source is the authority; if they
#    disagree, everything downstream is reasoning about hardware that no longer
#    exists — and nothing else in the system can notice, because the only thing
#    readable over I2C is a revision byte the compiler does not bump for you.
if [ -r "$FW_SRC" ]; then
    if [ -z "$FW_DRIFT" ]; then
        ok "timing-terms agrees with the firmware source on every constant"
    else
        haz "timing-terms has drifted from the firmware source:$FW_DRIFT" \
            "update timing-terms, and if the FIRMWARE changed, bump I2C_FW_REVISION too or the revision guard is defeated."
    fi
fi

# 10. The terms are only valid for one firmware revision, and the board is the
#     only thing that can say which one is actually running.
if [ -n "$FW_REV" ] && [ "$FW_REV" != "$FW_REV_TERM" ]; then
    haz "controller reports firmware revision $FW_REV; timing-terms describes rev $FW_REV_TERM" \
        "the alarm window, thermal inhibit and guaranteed-wake unit are all revision-specific. Re-read them from the firmware you actually flashed before trusting this table."
fi

# ── Things that are true and are not invariants ────────────────────────────
hdr "OBSERVATIONS — no arithmetic to fail, but they decide behaviour"

note "$(printf 'The %ss alarm window is a COINCIDENCE TEST, not a timeout. The controller\n        computes date*86400 + h*3600 + m*60 + s for both clocks and fires only while\n        0 <= now - alarm < %s, checked at 1 Hz. Miss it and the wake does not happen\n        LATE — it does not happen at all, until guaranteed wake %sh later.' \
    "$ALARM_WIN" "$ALARM_WIN" "$GW")"

note "$(printf 'Only wittypi rtc-write moves the RTC, so an NTP step (poll %s-%ss) is harmless\n        on its own. It becomes a lost wake when wittypi-rtc-save.path writes a stepped\n        clock through and the jump crosses a pending alarm. A DST conversion would be\n        a 3600s discontinuity against a %ss tolerance — hence UTC everywhere.' \
    "$NTP_MIN" "$NTP_MAX" "$ALARM_WIN")"

if [ -n "$RB_WD" ] && [ "$RB_WD" -gt "$PCD" ]; then
    note "$(printf 'RebootWatchdogSec (%ss) can never fire during a controller-initiated shutdown:\n        the rail is cut at %ss. The hard backstop here is the power cut, not systemd.' \
        "$RB_WD" "$PCD")"
fi

if [ -n "$SOAK" ] && [ "$T_BOOT" -lt "$SOAK" ]; then
    note "$(printf 'The soak SUBSUMES the boot (T_boot %ss < soak %ss), so mark-good lands at\n        ~%ss, not %s + %s. Those add only if the boot ever exceeds the soak.' \
        "$T_BOOT" "$SOAK" "$T_MARKGOOD" "$T_BOOT" "$SOAK")"
fi

if [ "$MODE" = board ] && [ -n "$DEFAULT_ON" ] && [ "$DEFAULT_ON" != 1 ]; then
    haz "default-on (reg 17) is $DEFAULT_ON, not 1" \
        "after a power interruption this node stays dark until someone presses the button. On an unattended node that is a site visit."
fi

if [ -n "$FW_REV" ]; then
    note "$(printf 'Register 12 cannot tell you which firmware this is. It reads %s on stock AND\n        on the patched build — the revision is deliberately not bumped (it advertises\n        vendor features, and WP_MIN_REV_GUARANTEED_WAKE keys off it) and no marker\n        fits in the flash. Identify by reading flash back and comparing\n        against firmware/wittypi/build/, which verifies the whole image:\n          avrdude -c usbasp-clone -p t841 -n            # warm-up, the first entry fails\n          avrdude -c usbasp-clone -p t841 -B 32kHz -U flash:r:/tmp/f.bin:r\n        WARNING: That holds RESET, which cuts the Pi. Shut the node down first.' "$FW_REV")"
fi

if [ "$MODE" = repo ]; then
    note 'repo mode shows COMPILED defaults — what an unconfigured node gets. The
        deployed node overrides some of these in /data/wittypi.env, which no build
        can see. Run this on the node for what is actually running.'
fi

printf '\n'
if [ "$hazards" = 0 ]; then
    printf '%s0 hazards%s, %s notes — every relationship above holds.\n' "$G" "$Z" "$notes"
    exit 0
fi
printf '%s%s hazard(s)%s, %s notes.\n' "$R" "$hazards" "$Z" "$notes"
exit 1
