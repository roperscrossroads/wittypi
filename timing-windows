row "slot-fail threshold" "$SLOT_FAIL" "boot-slot-health, CONSECUTIVE"
if [ "$MODE" = board ] && command -v fw_printenv >/dev/null 2>&1; then
    for s in A B; do
        row "BOOT_${s}_LEFT (live)" \
            "$(fw_printenv "BOOT_${s}_LEFT" 2>/dev/null | cut -d= -f2)" "u-boot env"
