row "gate TimeoutStartSec" "${GATE_TMO}s" "boot-health-check.service"
row "runtime watchdog" "${RT_WD}s" "10-watchdog.conf"
row "reboot watchdog" "${RB_WD}s" "10-watchdog.conf"
